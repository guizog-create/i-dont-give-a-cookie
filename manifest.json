{
  "manifest_version": 3,
  "name": "I Don't Give a Cookie",
  "description": "Automatically accepts cookie consent banners on virtually any website. Supports 30+ languages, all major CMPs, with click verification, CSS fallback, and SPA support.",
  "version": "2.1.0",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "I Don't Give a Cookie",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
